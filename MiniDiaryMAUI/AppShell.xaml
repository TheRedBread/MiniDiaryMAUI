<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="MiniDiaryMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MiniDiaryMAUI.Views"
    xmlns:local="clr-namespace:MiniDiaryMAUI"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="List"
        ContentTemplate="{DataTemplate views:ListPage}"
        Route="ListPage" />
    <ShellContent
        Title="Edit"
        ContentTemplate="{DataTemplate views:EditPage}"
        Route="EditPage" />
</Shell>
    