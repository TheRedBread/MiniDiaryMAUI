<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MiniDiaryMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MiniDiaryMAUI.Views"
    Title="MiniDiaryMAUI">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="List"
        ContentTemplate="{DataTemplate local:ListPage}"
        Route="ListPage" />
    <ShellContent
        Title="Edit"
        ContentTemplate="{DataTemplate local:EditPage}"
        Route="EditPage" />
</Shell>
