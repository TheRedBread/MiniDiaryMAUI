<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiniDiaryMAUI.Views.MainPage">

    <VerticalStackLayout>

        <Button
            Text="{Binding WeightTileText}"
            Command="{Binding OpenWeightCommand}" />

        <Button
            Text="{Binding NotesTileText}"
            Command="{Binding OpenNotesCommand}" />

    </VerticalStackLayout>

</ContentPage>