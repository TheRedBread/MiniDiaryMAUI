<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MiniDiaryMAUI.ViewModel"
             xmlns:models="clr-namespace:MiniDiaryMAUI.Models"
             xmlns:local="clr-namespace:MiniDiaryMAUI.Views"
             x:DataType="viewmodel:ListPageViewModel"
             x:Class="MiniDiaryMAUI.Views.ListPage"
             Title="ListPage">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding ListWeights}" IsVisible="{Binding IsWeights}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EntryWeight">
                    <VerticalStackLayout>
                        <Label Text="{Binding Weight}" FontAttributes="Bold" FontSize="Medium"/>
                        <Label Text="{Binding DateTime}" FontSize="Small"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView ItemsSource="{Binding ListNotes}" IsVisible="{Binding IsNotes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EntryNote">
                    <VerticalStackLayout>
                        <Label Text="{Binding Text}" FontAttributes="Bold" FontSize="Medium"/>
                        <Label Text="{Binding DateTime}" FontSize="Small"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="MainPage" Command="{Binding GoToMainPageCommand}" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>