<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MiniDiaryMAUI.ViewModel"
    xmlns:models="clr-namespace:MiniDiaryMAUI.Models"
    xmlns:controls="clr-namespace:MiniDiaryMAUI.Controls"
    x:DataType="viewmodel:ListPageViewModel"
    x:Class="MiniDiaryMAUI.Views.ListPage"
    BackgroundColor="{StaticResource AppBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- ========================= -->
        <!-- Main content               -->
        <!-- ========================= -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="21,22,21,20"
                Spacing="7">

                <!-- Header: back + title + add -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">

                    <Label
                        Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        TextColor="{StaticResource TextColor}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToMainPageCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Grid.Column="1"
                        Text="Waga"
                        IsVisible="{Binding IsWeights}"
                        Style="{StaticResource DashboardTitleStyle}" />

                    <Label
                        Grid.Column="1"
                        Text="Notatki"
                        IsVisible="{Binding IsNotes}"
                        Style="{StaticResource DashboardTitleStyle}" />

                    <Label
                        Grid.Column="2"
                        Text="+"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Accent}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddEntryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                </Grid>

                <!-- WEIGHTS -->
                <CollectionView
                    ItemsSource="{Binding ListWeights}"
                    IsVisible="{Binding IsWeights}">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="7" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label
                            Text="Brak wpisów wagi"
                            TextColor="{StaticResource TextColor}"
                            HorizontalOptions="Center"
                            Margin="0,30,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <!-- WEIGHTS ItemTemplate -->
                        <DataTemplate x:DataType="models:EntryWeight">
                            <Border Style="{StaticResource DashboardCardStyle}">

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                    Text="{Binding Weight, StringFormat='{0} kg'}"
                    Style="{StaticResource DashboardValueStyle}"
                    FontAttributes="Bold" />

                                        <Label
                    Text="{Binding DateTime, StringFormat='{0:dd.MM.yyyy, HH:mm}'}"
                    Style="{StaticResource DateLabelStyle}" />
                                    </VerticalStackLayout>

                                    <Border
                Grid.Column="1"
                BackgroundColor="Transparent"
                Stroke="{StaticResource Accent}"
                StrokeThickness="1.5"
                Padding="10,6"
                VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListPageViewModel}}, Path=ViewWeightDetailsCommand}"
                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Szczegóły" FontSize="12" TextColor="{StaticResource Accent}" />
                                    </Border>

                                    <Border
                Grid.Column="2"
                BackgroundColor="{StaticResource Accent}"
                StrokeThickness="0"
                Padding="10,6"
                VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListPageViewModel}}, Path=EditWeightEntryCommand}"
                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Edytuj" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                    </Border>

                                    <Border
                Grid.Column="3"
                BackgroundColor="Transparent"
                Stroke="#C0392B"
                StrokeThickness="1.5"
                Padding="10,6"
                VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListPageViewModel}}, Path=DeleteWeightEntryCommand}"
                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Usuń" FontSize="12" TextColor="#C0392B" />
                                    </Border>

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- NOTES -->
                <CollectionView
                    ItemsSource="{Binding ListNotes}"
                    IsVisible="{Binding IsNotes}">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="7" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label
                            Text="Brak notatek"
                            TextColor="{StaticResource TextColor}"
                            HorizontalOptions="Center"
                            Margin="0,30,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <!-- NOTES ItemTemplate -->
                        <DataTemplate x:DataType="models:EntryNote">
                            <Border Style="{StaticResource DashboardCardStyle}">

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                    Text="{Binding Text}"
                    Style="{StaticResource DashboardValueStyle}"
                    LineBreakMode="TailTruncation"
                    MaxLines="2" />

                                        <Label
                    Text="{Binding DateTime, StringFormat='{0:dd.MM.yyyy, HH:mm}'}"
                    Style="{StaticResource DateLabelStyle}" />
                                    </VerticalStackLayout>

                                    <Border
                Grid.Column="1"
                BackgroundColor="Transparent"
                Stroke="{StaticResource Accent}"
                StrokeThickness="1.5"
                Padding="10,6"
                VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListPageViewModel}}, Path=ViewNoteDetailsCommand}"
                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Szczegóły" FontSize="12" TextColor="{StaticResource Accent}" />
                                    </Border>

                                    <Border
                Grid.Column="2"
                BackgroundColor="{StaticResource Accent}"
                StrokeThickness="0"
                Padding="10,6"
                VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListPageViewModel}}, Path=EditNoteEntryCommand}"
                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Edytuj" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                    </Border>

                                    <Border
                Grid.Column="3"
                BackgroundColor="Transparent"
                Stroke="#C0392B"
                StrokeThickness="1.5"
                Padding="10,6"
                VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListPageViewModel}}, Path=DeleteNoteEntryCommand}"
                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Usuń" FontSize="12" TextColor="#C0392B" />
                                    </Border>

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <controls:BottomNavigation Grid.Row="1" />

    </Grid>

</ContentPage>