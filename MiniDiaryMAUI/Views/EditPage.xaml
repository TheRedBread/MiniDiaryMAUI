<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MiniDiaryMAUI.ViewModels"
    xmlns:controls="clr-namespace:MiniDiaryMAUI.Controls"
    x:DataType="viewmodels:EditViewModel"
    x:Class="MiniDiaryMAUI.Views.EditPage"
    BackgroundColor="{StaticResource AppBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- ========================= -->
        <!-- Main content               -->
        <!-- ========================= -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="21,22,21,20"
                Spacing="7">

                <!-- Header: back + dynamic title -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">

                    <Label
                        Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        TextColor="{StaticResource TextColor}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToMainPageCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Grid.Column="1"
                        Text="{Binding PageTitle}"
                        Style="{StaticResource DashboardTitleStyle}" />

                </Grid>

                <!-- TYPE TOGGLE (only when creating) -->
                <Border
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="10"
                    IsVisible="{Binding CanChangeEntryType}">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">

                        <Border Grid.Column="0" StrokeThickness="0" HeightRequest="40">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsNoteEntry}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsNoteEntry}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectEntryTypeCommand}" CommandParameter="notes" />
                            </Border.GestureRecognizers>
                            <Label Text="Notatka" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsNoteEntry}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsNoteEntry}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                                        <Setter Property="FontAttributes" Value="None" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <Border Grid.Column="1" StrokeThickness="0" HeightRequest="40">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsWeightEntry}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsWeightEntry}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectEntryTypeCommand}" CommandParameter="weights" />
                            </Border.GestureRecognizers>
                            <Label Text="Waga" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsWeightEntry}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsWeightEntry}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                                        <Setter Property="FontAttributes" Value="None" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                    </Grid>

                </Border>

                <!-- FORM -->
                <Border Style="{StaticResource DashboardCardStyle}">

                    <VerticalStackLayout Spacing="16">

                        <!-- NOTE field -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsNoteEntry}">
                            <Label
                                Text="Notatka"
                                Style="{StaticResource DateLabelStyle}" />

                            <Entry
                                Text="{Binding InputText}"
                                Placeholder="Wpisz treść..."
                                TextColor="{StaticResource TextColor}"
                                PlaceholderColor="#8A5A3B" />
                        </VerticalStackLayout>

                        <!-- WEIGHT field -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsWeightEntry}">
                            <Label
                                Text="Waga (kg)"
                                Style="{StaticResource DateLabelStyle}" />

                            <Entry
                                Text="{Binding InputText}"
                                Placeholder="np. 81.5"
                                Keyboard="Numeric"
                                TextColor="{StaticResource TextColor}"
                                PlaceholderColor="#8A5A3B" />
                        </VerticalStackLayout>

                        <BoxView
                            HeightRequest="1"
                            Color="#C58C68"
                            Opacity="0.5" />

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Data"
                                Style="{StaticResource DateLabelStyle}" />

                            <DatePicker
                                Date="{Binding InputDate}"
                                TextColor="{StaticResource TextColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Godzina"
                                Style="{StaticResource DateLabelStyle}" />

                            <TimePicker
                                Time="{Binding InputTime}"
                                TextColor="{StaticResource TextColor}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- SAVE -->
                <Border
                    BackgroundColor="{StaticResource Accent}"
                    StrokeThickness="0"
                    HeightRequest="52"
                    Margin="0,7,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveEntryCommand}" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="Zapisz"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <controls:BottomNavigation Grid.Row="1" />

    </Grid>

</ContentPage>