<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MiniDiaryMAUI.ViewModels"
             x:DataType="viewmodels:EditViewModel"
             x:Class="MiniDiaryMAUI.Views.EditPage"
             Title="EditPage">
    <VerticalStackLayout>

        <Button Text="Back to Main Page" Command="{Binding GoToMainPageCommand}" HorizontalOptions="Center"/>
        <Entry Text="{Binding InputText}" Placeholder="Enter input here" HorizontalOptions="Center"/>
        <DatePicker Date="{Binding InputDate}" HorizontalOptions="Center"/>
        <TimePicker Time="{Binding InputTime}" HorizontalOptions="Center"/>
        <Button Text="Save" Command="{Binding SaveEntryCommand}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>