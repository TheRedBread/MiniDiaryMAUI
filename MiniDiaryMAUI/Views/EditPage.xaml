<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MiniDiaryMAUI.ViewModels"
             x:DataType="viewmodels:EditViewModel"
             x:Class="MiniDiaryMAUI.Views.EditPage"
             Title="EditPage">
    <VerticalStackLayout>
        <Label Text="{Binding EditId}" HorizontalOptions="Center"/>
        <Button Text="Back to Main Page" Command="{Binding GoToMainPageCommand}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>